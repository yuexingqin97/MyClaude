# ASR 后端选择：faster-whisper（默认）或 volcengine
ASR_BACKEND=faster-whisper

# 视频解析/下载代理 - 用于获取抖音/小红书/B站视频信息和下载地址（YouTube 不需要）
# 推荐：AI Douyin，注册后可用免费额度试用；成功解析下载直链后扣 1 积分
# 配置教程: docs/ai-douyin-setup.md
VIDEO_INFO_PROVIDER=ai-douyin
AI_DOUYIN_API_BASE=https://ai-douyin.top9.cc
AI_DOUYIN_API_KEY=your_ai_douyin_api_key

# 高级/自托管：如需绕过 AI Douyin，可改为 VIDEO_INFO_PROVIDER=tikhub 并配置自己的 TikHub Token
# 申请教程: docs/tikhub-setup.md
TIKHUB_TOKEN=

# faster-whisper - 本地语音转写运行时参数（ASR_BACKEND=faster-whisper 时生效）
# 安装教程: docs/faster-whisper-setup.md
FW_MODEL_SIZE=small
FW_DEVICE=auto
FW_COMPUTE_TYPE=
FW_PYTHON=

# 火山引擎 VC - 云端字幕转写参数（ASR_BACKEND=volcengine 时生效）
# 安装教程: docs/bytedance-vc-setup.md
BYTEDANCE_VC_TOKEN=your_bytedance_vc_token
BYTEDANCE_VC_APPID=your_bytedance_vc_appid

# 关键帧截图参数（学习模式）
KF_INTERVAL=30
KF_MAX_FRAMES=50
KF_MODE=interval

# 完成后自动清理临时文件（true=清理释放空间, false=保留调试）
CLEANUP_TEMP=true

# 文档末尾附加生成元信息（生成时间/模型/Token/免责声明）
NOTE_METADATA=true
# 默认笔记输出目录 / Default note output path（空=当前工作目录，例：D:/Notes 或 ./大衍决残卷）
NOTE_OUTPUT_DIR=""

# ── 功能开关 / Feature Toggles（全部默认 true，设为 false 关闭）──
# 关键帧截图 / Screenshot extraction & embedding in notes
ENABLE_KEYFRAMES=true
# Mermaid 图表自动绘制 / Auto-generate architecture/flow/sequence diagrams
ENABLE_MERMAID=true
# 扩展学习资源推荐 / Recommend docs, videos, articles, GitHub repos
ENABLE_RESOURCES=true
# 评论区精华提取 / Curate valuable comments from video comment section
ENABLE_COMMENTS=true
# 阅读时长/难度/可靠性评级 / Reading time, difficulty & reliability ratings
ENABLE_READING_INFO=true
# 处理前灵力预估 / Pre-flight estimation: time & token cost, confirm before large tasks
ENABLE_ESTIMATION=true
# 调试元信息 / Debug trace: tool calls & decision chain in metadata footer（默认 false）
DEBUG_METADATA=false
# 收尾 / Post-processing
# 笔记生成后自动更新修为面板 / Auto-update cultivation panel after note generation
AUTO_UPDATE_PANEL=true
# 工作结束后提供学习路线推荐 / Offer learning roadmap suggestions after workflow
AUTO_SUGGEST_NEXT=true
